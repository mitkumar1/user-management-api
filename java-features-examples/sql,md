## 14. Common Interview Queries
- Find 2nd highest salary:
```sql
SELECT MAX(salary) FROM employees WHERE salary < (SELECT MAX(salary) FROM employees);
```
- Find duplicate records:
```sql
SELECT name, COUNT(*) FROM employees GROUP BY name HAVING COUNT(*) > 1;
```
- Employees with no manager:
```sql
SELECT * FROM employees WHERE manager_id IS NULL;
```
- Department with max employees:
```sql
SELECT dept_id, COUNT(*) FROM employees GROUP BY dept_id ORDER BY COUNT(*) DESC LIMIT 1;
```
- Employees who joined in last 30 days:
```sql
SELECT * FROM employees WHERE join_date >= CURRENT_DATE - INTERVAL '30 days';
```
- Top N salaries (e.g., top 3):
```sql
SELECT DISTINCT salary FROM employees ORDER BY salary DESC LIMIT 3;
```
- Employees with same salary:
```sql
SELECT salary, COUNT(*) FROM employees GROUP BY salary HAVING COUNT(*) > 1;
```
- Employees in more than one department:
```sql
SELECT employee_id FROM employee_departments GROUP BY employee_id HAVING COUNT(department_id) > 1;
```
- Employees who never submitted a timesheet:
```sql
SELECT e.* FROM employees e LEFT JOIN timesheets t ON e.id = t.employee_id WHERE t.employee_id IS NULL;
```
- Highest salary in each department:
```sql
SELECT dept_id, MAX(salary) FROM employees GROUP BY dept_id;
```
- Employees whose name starts and ends with 'A':
```sql
SELECT * FROM employees WHERE name LIKE 'A%A';
```
- Count of employees per job title:
```sql
SELECT job_title, COUNT(*) FROM employees GROUP BY job_title;
```
- Employees with salary above department average:
```sql
SELECT * FROM employees e WHERE salary > (SELECT AVG(salary) FROM employees WHERE dept_id = e.dept_id);
```
- Employees with the minimum salary:
```sql
SELECT * FROM employees WHERE salary = (SELECT MIN(salary) FROM employees);
```
- List managers and their direct report count:
```sql
SELECT manager_id, COUNT(*) AS report_count FROM employees WHERE manager_id IS NOT NULL GROUP BY manager_id;
```
- Employees with palindrome names:
```sql
SELECT * FROM employees WHERE name = REVERSE(name);
```
- Employees with email domain 'gmail.com':
```sql
SELECT * FROM employees WHERE email LIKE '%@gmail.com';
```
- Employees hired in a specific year (e.g., 2024):
```sql
SELECT * FROM employees WHERE EXTRACT(YEAR FROM join_date) = 2024;
```
- Employees with the highest salary in their department:
```sql
SELECT * FROM employees e WHERE salary = (SELECT MAX(salary) FROM employees WHERE dept_id = e.dept_id);
```
- Employees who have both 'Developer' and 'Tester' roles:
```sql
SELECT employee_id FROM employee_roles WHERE role IN ('Developer', 'Tester') GROUP BY employee_id HAVING COUNT(DISTINCT role) = 2;
```
- Employees who have never been late (no late entries in attendance):
```sql
SELECT e.* FROM employees e WHERE NOT EXISTS (SELECT 1 FROM attendance a WHERE a.employee_id = e.id AND a.status = 'Late');
```

